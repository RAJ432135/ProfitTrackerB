{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Host=YOUR_HOST;Port=5432;Database=postgres;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true"
    },
    "Jwt": {
        "Secret": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS",
        "Issuer": "VehicleProfitTracker",
        "Audience": "VehicleProfitTrackerClient",
        "AccessTokenExpiryMinutes": 60
    },
    "Cors": {
        "AllowedOrigins": [
            "http://localhost:19006",
            "https://your-admin-portal-url.up.railway.app"
        ]
    },
    "IpRateLimiting": {
        "EnableEndpointRateLimiting": true,
        "StackBlockedRequests": false,
        "RealIpHeader": "X-Real-IP",
        "ClientIdHeader": "X-ClientId",
        "HttpStatusCode": 429,
        "GeneralRules": [
            {
                "Endpoint": "post:/api/v1/auth/login",
                "Period": "1m",
                "Limit": 20
            },
            {
                "Endpoint": "post:/api/v1/auth/register",
                "Period": "1m",
                "Limit": 5
            },
            {
                "Endpoint": "post:/api/v1/auth/forgot-password",
                "Period": "1m",
                "Limit": 5
            },
            {
                "Endpoint": "post:/api/v1/auth/reset-password",
                "Period": "1m",
                "Limit": 10
            },
            {
                "Endpoint": "*",
                "Period": "1m",
                "Limit": 120
            }
        ]
    }
}
