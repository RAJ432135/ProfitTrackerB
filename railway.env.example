# Railway Environment Variables Template
# Copy these into your Railway project's "Variables" tab
# Replace the placeholder values with your actual secrets

# Database Configuration
# If using Railway PostgreSQL: Leave this commented - Railway auto-injects DATABASE_URL
# If using Supabase: Uncomment and set your connection string
# DefaultConnection=Host=your-project-ref.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# JWT Configuration (CHANGE THESE VALUES IN PRODUCTION!)
Jwt__Secret=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__Issuer=VehicleProfitTracker
Jwt__Audience=VehicleProfitTrackerClient
Jwt__AccessTokenExpiryMinutes=60

# Environment
ASPNETCORE_ENVIRONMENT=Production

# Logging
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

# CORS Configuration
# Update these with your actual frontend domain
Cors__AllowedOrigins__0=https://your-frontend-domain.com
Cors__AllowedOrigins__1=https://www.your-frontend-domain.com

# Rate Limiting
IpRateLimiting__EnableEndpointRateLimiting=true
